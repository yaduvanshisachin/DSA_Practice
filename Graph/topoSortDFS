//we have seen topological sort using bfs , this is toposort using dfs
#include <iostream>
#include <vector>
#include <stack>

using namespace std;

bool dfs(int node, vector<vector<int>>& adj,
         vector<bool>& visited,
         vector<bool>& recStack,
         stack<int>& st) {

    visited[node] = true;
    recStack[node] = true;

    for (int neighbor : adj[node]) {
        if (!visited[neighbor]) {
            if (dfs(neighbor, adj, visited, recStack, st))
                return true;
        }
        else if (recStack[neighbor]) {
            // Cycle detected
            return true;
        }
    }

    recStack[node] = false;
    st.push(node);
    return false;
}

vector<int> topologicalSortDFS(int V, vector<vector<int>>& adj) {
    vector<bool> visited(V, false);
    vector<bool> recStack(V, false);
    stack<int> st;

    for (int i = 0; i < V; i++) {
        if (!visited[i]) {
            if (dfs(i, adj, visited, recStack, st)) {
                cout << "Graph contains a cycle!\n";
                return {};
            }
        }
    }

    vector<int> topoOrder;
    while (!st.empty()) {
        topoOrder.push_back(st.top());
        st.pop();
    }

    return topoOrder;
}